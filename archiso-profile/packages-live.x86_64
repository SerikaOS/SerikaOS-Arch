# ============================================================
# SerikaOS — Live ISO Package List (ULTRA MINIMAL)
# ============================================================
# Goal: Smallest possible ISO that boots into a working desktop
# with the Calamares installer. ALL other software is chosen
# by the user during installation via the netinstall module.
# ============================================================

# ── Base System ──
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
syslinux

# ── Bootloader ──
grub
efibootmgr

# ── Essential GPU ──
mesa
xf86-video-vesa

# ── Network (live must have connectivity) ──
networkmanager
iwd
wpa_supplicant

# ── Audio (minimal PipeWire for live session) ──
pipewire
pipewire-pulse
wireplumber

# ── Filesystem (partitioning & mounting) ──
btrfs-progs
dosfstools
e2fsprogs
ntfs-3g
gptfdisk

# ── Core Utilities ──
sudo
nano
curl
wget
less
which
pv

# ── Live Desktop (KDE Plasma – minimal set) ──
plasma-desktop
plasma-nm
plasma-pa
sddm
plymouth
konsole
dolphin
breeze
breeze-gtk

# ── Installer ──
calamares
ckbcomp
arch-install-scripts
qt5-base
qt5-declarative
qt5-svg
qt5-quickcontrols2
qt5-graphicaleffects
yaml-cpp
kpmcore
boost-libs
icu
polkit-qt5
qt6-5compat

# ── Theming ──
papirus-icon-theme
noto-fonts
ttf-dejavu

# ── Branding & Info ──
fastfetch
xdg-utils
xdg-user-dirs
