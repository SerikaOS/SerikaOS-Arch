# ============================================================
# SerikaOS — ISO Package List
# ============================================================
# This is the LIVE ISO package list. It should be as small as
# possible. The user selects their desired software during
# installation via the Calamares netinstall module.
#
# Strategy: Ship only what's needed for:
#   1. Booting into a working KDE Plasma desktop
#   2. Running the Calamares graphical installer
#   3. Basic hardware support & network connectivity
# ============================================================

# ── Base System ──
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
syslinux

# ── Bootloader ──
grub
efibootmgr

# ── GPU Drivers (minimal – covers most hardware) ──
mesa
xf86-video-vesa
xf86-video-amdgpu
xf86-video-intel
xf86-video-nouveau
xf86-video-qxl
spice-vdagent
qemu-guest-agent

# ── Network ──
networkmanager
network-manager-applet
wpa_supplicant
iwd
dhcpcd

# ── Audio ──
pipewire
pipewire-pulse
wireplumber

# ── Filesystem ──
btrfs-progs
dosfstools
e2fsprogs
ntfs-3g
gptfdisk

# ── Core Utilities ──
sudo
nano
git
curl
wget
less
which
pv

# ── KDE Plasma (live desktop) ──
plasma-desktop
plasma-nm
plasma-pa
plasma-workspace
kwin
kwayland-integration
sddm
sddm-kcm
xorg-xinit
plymouth
konsole
dolphin
breeze
breeze-gtk
kde-gtk-config
xdg-desktop-portal-kde
xdg-desktop-portal
qt6-wayland
qt5-wayland
wayland
wayland-protocols
libxkbcommon

# ── Calamares Installer + Dependencies ──
calamares
ckbcomp
arch-install-scripts
qt5-base
qt5-declarative
qt5-svg
qt5-quickcontrols2
qt5-graphicaleffects
yaml-cpp
kpmcore
boost-libs
icu
polkit-qt5
qt6-5compat

# ── Theming ──
papirus-icon-theme
noto-fonts
ttf-dejavu

# ── System Branding & Tools ──
fastfetch
xdg-utils
xdg-user-dirs
